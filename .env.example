DEBUG=True
SECRET_KEY=X


# Configuración de Base de Datos para Docker
DB_NAME=pintaebook_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432


# OAuth
GOOGLE_CLIENT_ID=CHECKDOC

# Persistencia NoSQL MongoDB Atlas
MONGO_URI=Checkdoc
MONGO_DB_NAME=pintaebook_nosql

# Configuración OpenRouter / IA
OPENROUTER_API_KEY=key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=dots-studio/dots-3-note-preview:free
AI_MOCK_MODE=FALSE #No hace falta porque usamos modelo gratuito de AI, por si algun motivo falla entonces volver a ponerlo en "True" para que siga funcionando el workflow.

# Redis / Channel Layer (En Railway asignar ${REDIS_URL})
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- Correo (recuperacion de contrasena por OTP) ---
# Por defecto (sin definir nada) el correo se imprime en consola: docker compose logs web
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-cuenta@gmail.com
# Contrasena de APLICACION de Google (requiere verificacion en 2 pasos), no la contrasena de la cuenta
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=tu-cuenta@gmail.com
# OJO: Render (plan free) bloquea el SMTP saliente (puertos 25/465/587); alli hace falta un proveedor por API HTTP.
# Produccion / Render: Brevo por API HTTP (django-anymail). Sirve tambien en local.
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# API key v3 de Brevo (SMTP & API -> API Keys). No es la "SMTP key". Secreta: no subirla al repo
# BREVO_API_KEY=
# Debe ser un remitente VERIFICADO en Brevo (Senders). Ej: Pinta Ebook <tu-cuenta@gmail.com>
# DEFAULT_FROM_EMAIL=

# --- Mercado Pago (Checkout Pro) ---
# Credencial de la API. Dejar vacía en el repositorio; cada desarrollador usa la suya en su .env
MERCADOPAGO_ACCESS_TOKEN=
# True: usa el sandbox_init_point. Con credenciales de una cuenta de prueba dejar en False (usa init_point)
MERCADOPAGO_SANDBOX=False
# True: no llama a Mercado Pago ni necesita credenciales (solo desarrollo y tests). En produccion debe ser False
MERCADOPAGO_MOCK_MODE=False
# URLs del frontend a las que vuelve el usuario tras pagar. Ej. local: http://localhost:4200/billing/result/success
# (MP descarta las URLs con localhost: en local no hay redireccion al front; con "https://" en produccion si)
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=
# URL publica del webhook (POST /api/billing/webhook/). Mercado Pago no puede llegar a localhost:
# en desarrollo usar un tunel (ngrok); en produccion, la URL del backend desplegado.
MERCADOPAGO_NOTIFICATION_URL=
# Dominios que Django acepta, separados por coma (incluir el del tunel (puede ser ngrok) o el de produccion)
ALLOWED_HOSTS=localhost,127.0.0.1
