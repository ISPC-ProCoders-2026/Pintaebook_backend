DEBUG=True
SECRET_KEY=X


# Configuración de Base de Datos para Docker
DB_NAME=pintaebook_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432


# OAuth
