DEBUG=True
SECRET_KEY=X


# Configuración de Base de Datos para Docker
DB_NAME=pintaebook_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432


# OAuth
GOOGLE_CLIENT_ID=CHECKDOC

# Persistencia NoSQL MongoDB Atlas
MONGO_URI=Checkdoc
MONGO_DB_NAME=pintaebook_nosql

# Configuración OpenRouter / IA
OPENROUTER_API_KEY=key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=dots-studio/dots-3-note-preview:free
AI_MOCK_MODE=FALSE #No hace falta porque usamos modelo gratuito de AI, por si algun motivo falla entonces volver a ponerlo en "True" para que siga funcionando el workflow.

# Redis / Channel Layer (En Railway asignar ${REDIS_URL})
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379